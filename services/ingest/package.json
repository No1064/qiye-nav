{
  "name": "@personal-nav/ingest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "check-home-ui": "node ../../scripts/sync-newtab-home.mjs --check",
    "pretest": "npm run check-home-ui",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "node dist/migration.js",
    "password": "node dist/password.js hash"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
