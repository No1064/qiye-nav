# Compose
QIYE_IMAGE=qiye:0.2.0
COMPOSE_PROJECT_NAME=personal-nav
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
INGEST_PORT=8787

# Same-origin gateway
CADDY_IMAGE=caddy:2.10.2-alpine

# Management login. Generate the hash with ./scripts/set-admin-password.sh.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Set true only when the browser-facing management origin is HTTPS.
ADMIN_COOKIE_SECURE=false

# Generated automatically by start.sh. Must decode to exactly 32 bytes.
# Do not reuse the administrator password or extension token.
AI_CONFIG_ENCRYPTION_KEY=change-me-ai-config-encryption-key

# Chrome extension only. Never use this token to log in to /manage/.
INGEST_TOKEN=change-me-ingest-token
# Bind-mounted ops/data must be writable by this unprivileged container user.
# start.sh automatically exports the current host user's IDs for its own commands.
NAV_UID=1000
NAV_GID=1000
# Exact website origins allowed to cross-read the public catalog API. The web UI is same-origin,
# so leave this empty unless another site must read it. Extension origins (chrome-extension://
# and moz-extension://) are always accepted, which is why Safari and Chrome connect on a fresh
# install. * lets any website read the public catalog; do not use it for private catalogs.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
